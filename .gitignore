# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# debug and logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (an example file can still be committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
*.pem

# OS files
.DS_Store
Thumbs.db
desktop.ini

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Claude Code: per-machine settings and worktrees (shared skills and CLAUDE.md stay tracked)
.claude/settings.local.json
.claude/worktrees/

# local-only skill with large binaries (installed separately)
/.claude/skills/impeccable/

# Impeccable: screenshots, build state, mocks and caches are per-session.
# config.json and design.json (the DESIGN.md sidecar) stay tracked.
/.impeccable/review/
/.impeccable/build/
/.impeccable/mocks/
/.impeccable/*.cache.json
/.impeccable/config.local.json

# design-taste-frontend working files
/.taste-skill/
